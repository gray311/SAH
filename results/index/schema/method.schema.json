{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "method",
  "description": "Dimension row: one method variant = model variant + methodology. This is the unit a plot legend entry maps to. Fields the artifacts do not record are null and listed in unknown_fields; they are filled by ASKING THE USER, never inferred.",
  "type": "object",
  "required": ["method_id", "label", "family", "executor", "unknown_fields"],
  "additionalProperties": false,
  "properties": {
    "method_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "assigned once, never reused or redefined; a config change means a NEW method_id"},
    "label": {"type": "string", "description": "human label for tables/legends"},
    "family": {
      "type": "string",
      "enum": ["external", "seed", "h2_initial", "learned_proposer"],
      "description": "external = published baseline (Qwen3.5-9B, Finch-9B); seed = no search; h2_initial = hand-written harness; learned_proposer = M_phi-generated H2"
    },
    "executor": {
      "type": "object",
      "description": "the frozen M0 that runs the inner search",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": {"type": "string"},
        "frozen": {"type": ["boolean", "null"]},
        "serving": {"type": ["string", "null"], "description": "e.g. vllm"},
        "sampling": {"type": ["object", "null"], "additionalProperties": true}
      }
    },
    "proposer": {
      "type": ["object", "null"],
      "description": "M_phi; null for non-learned families",
      "additionalProperties": false,
      "properties": {
        "model": {"type": ["string", "null"]},
        "lora": {"type": ["object", "null"], "additionalProperties": true, "description": "e.g. {rank: 64, alpha: 128}"},
        "checkpoint": {"type": ["string", "null"], "description": "e.g. mphi_s019"},
        "checkpoint_lineage": {"type": ["string", "null"], "description": "trunk / branch, and whether it is from a rolled-back range"},
        "h1_version": {"type": ["string", "null"]},
        "h1_package_hash": {"type": ["string", "null"]}
      }
    },
    "algorithm": {
      "type": ["object", "null"],
      "description": "the outer RL update",
      "additionalProperties": false,
      "properties": {
        "adv_mode": {"type": ["string", "null"], "enum": ["legacy", "v2", null], "description": "SAH_ADV"},
        "sharpen_alpha": {"type": ["number", "null"], "description": "SAH_ALPHA"},
        "k": {"type": ["integer", "null"], "description": "group size (candidates per task per round)"},
        "kl_coef": {"type": ["number", "null"]},
        "reward": {"type": ["string", "null"], "description": "reward transform, e.g. clip((score-base)/|base|, -1, +5)"}
      }
    },
    "search": {
      "type": ["object", "null"],
      "description": "inner/outer search mechanisms — the methodology toggles",
      "additionalProperties": false,
      "properties": {
        "cascade": {"type": ["boolean", "null"], "description": "successive halving over candidates"},
        "cascade_top_n": {"type": ["integer", "null"]},
        "program_inheritance": {"type": ["boolean", "null"], "description": "best_programs.json ratchet"},
        "crossover_parents": {"type": ["integer", "null"]},
        "stall_restart": {"type": ["boolean", "null"]},
        "probe": {"type": ["boolean", "null"], "description": "cheap subsampled off-budget eval available"},
        "analyst_note": {"type": ["boolean", "null"], "description": "human-curated intelligence injected into H1 context"}
      }
    },
    "genome": {"type": ["string", "null"], "description": "harness spec version, e.g. h2spec/1.0 (generative) vs fixed-field"},
    "budget": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "max_evals": {"type": ["integer", "null"]},
        "seeds": {"type": ["integer", "null"], "description": "replications per (method, task); 1 = single seed, no error bars"}
      }
    },
    "provenance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "workspace": {"type": ["string", "null"], "description": "cluster path this method's rounds live under"},
        "round_ranges": {"type": "array", "items": {"type": "array", "items": {"type": "integer"}}},
        "jobs": {"type": "array", "items": {"type": ["string", "integer"]}},
        "date": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]}
      }
    },
    "unknown_fields": {
      "type": "array",
      "items": {"type": "string"},
      "description": "dotted paths that are null because they were never recorded. Empty = fully specified. ASK THE USER to fill these; do not infer."
    },
    "notes": {"type": ["string", "null"]}
  }
}
