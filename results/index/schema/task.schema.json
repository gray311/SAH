{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task",
  "description": "Dimension row: one benchmark task. Stable; changes only when a task is added or a reference score is published.",
  "type": "object",
  "required": ["task_id", "suite", "family", "name", "source", "reported", "primary_metric", "raw_metric", "references"],
  "additionalProperties": false,
  "properties": {
    "task_id": {"type": "string", "pattern": "^[a-z0-9]+__[a-z0-9_]+(__[a-z0-9_]+)?$", "description": "3 segments for eft (<suite>__<family>__<name>), 2 for the flat adrs ids"},
    "suite": {"type": "string", "enum": ["eft", "adrs"]},
    "family": {"type": "string", "description": "math | ahc_simpletes | algotune | '' for flat adrs ids"},
    "name": {"type": "string"},
    "source": {"type": "string", "enum": ["eft", "simpletes", "adrs"], "description": "on-disk layout the registry loads"},
    "reported": {"type": "boolean", "description": "is this a column of the main table"},
    "domain": {"type": ["string", "null"]},
    "plan_family": {"type": ["string", "null"]},
    "cost_tier": {"type": ["string", "null"]},
    "language": {"type": ["string", "null"]},
    "primary_metric": {
      "type": "object",
      "required": ["name", "direction"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "combined_score"},
        "direction": {"const": "max", "description": "combined_score is always higher-is-better"}
      }
    },
    "raw_metric": {
      "type": "object",
      "description": "the paper-scale metric and how it maps to combined_score",
      "required": ["name", "direction", "to_combined"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "description": "c5 | c1 | c2 | sum_radii | det_ratio | score_sum | combined_score"},
        "direction": {"type": "string", "enum": ["max", "min"]},
        "to_combined": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": {"type": "string", "enum": ["identity", "divide_by", "const_over"]},
            "const": {"type": ["number", "null"]},
            "derivation": {"type": ["string", "null"], "description": "how const was obtained; keep the audit trail"}
          }
        }
      }
    },
    "references": {
      "type": "object",
      "description": "comparison points in COMBINED scale (null = not published / not measured)",
      "additionalProperties": false,
      "properties": {
        "seed": {"type": ["number", "null"], "description": "seed program, no search"},
        "h2_initial": {"type": ["number", "null"], "description": "hand-written H2, 20 evals, single seed"},
        "qwen35_9b": {"type": ["number", "null"], "description": "official Qwen3.5-9B (EFT's own harness/budget)"},
        "finch_9b": {"type": ["number", "null"]},
        "sota_le10b": {"type": ["number", "null"]}
      }
    },
    "references_raw": {
      "type": "object",
      "description": "the same points on the paper scale, as published; informational",
      "additionalProperties": {"type": ["number", "null"]}
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_max_evals": {"type": ["integer", "null"]},
        "per_eval_timeout_s": {"type": ["number", "null"]},
        "env_requirements": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": ["string", "null"]}
      }
    },
    "notes": {"type": ["string", "null"]}
  }
}
